#!/sbin/runscript

# backward compatibility for existing gentoo layout 
#
if [ -d "/var/lib/pyrrha/.pyrrha" ]; then
	PYRRHAD_DEFAULT_DATADIR="/var/lib/pyrrha/.pyrrha"
else
	PYRRHAD_DEFAULT_DATADIR="/var/lib/pyrrhad"
fi

PYRRHAD_CONFIGFILE=${PYRRHAD_CONFIGFILE:-/etc/pyrrha/pyrrha.conf}
PYRRHAD_PIDDIR=${PYRRHAD_PIDDIR:-/var/run/pyrrhad}
PYRRHAD_PIDFILE=${PYRRHAD_PIDFILE:-${PYRRHAD_PIDDIR}/pyrrhad.pid}
PYRRHAD_DATADIR=${PYRRHAD_DATADIR:-${PYRRHAD_DEFAULT_DATADIR}}
PYRRHAD_USER=${PYRRHAD_USER:-${PYRRHA_USER:-pyrrha}}
PYRRHAD_GROUP=${PYRRHAD_GROUP:-pyrrha}
PYRRHAD_BIN=${PYRRHAD_BIN:-/usr/bin/pyrrhad}
PYRRHAD_NICE=${PYRRHAD_NICE:-${NICELEVEL:-0}}
PYRRHAD_OPTS="${PYRRHAD_OPTS:-${PYRRHA_OPTS}}"

name="Pyrrha Daemon"
description="Pyrrha cryptocurrency P2P network daemon"

command="/usr/bin/pyrrhad"
command_args="-pid=\"${PYRRHAD_PIDFILE}\" \
		-conf=\"${PYRRHAD_CONFIGFILE}\" \
		-datadir=\"${PYRRHAD_DATADIR}\" \
		-daemon \
		${PYRRHAD_OPTS}"

required_files="${PYRRHAD_CONFIGFILE}"
start_stop_daemon_args="-u ${PYRRHAD_USER} \
			-N ${PYRRHAD_NICE} -w 2000"
pidfile="${PYRRHAD_PIDFILE}"

# The retry schedule to use when stopping the daemon. Could be either
# a timeout in seconds or multiple signal/timeout pairs (like
# "SIGKILL/180 SIGTERM/300")
retry="${PYRRHAD_SIGTERM_TIMEOUT}"

depend() {
	need localmount net
}

# verify
# 1) that the datadir exists and is writable (or create it)
# 2) that a directory for the pid exists and is writable
# 3) ownership and permissions on the config file
start_pre() {
	checkpath \
	-d \
	--mode 0750 \
	--owner "${PYRRHAD_USER}:${PYRRHAD_GROUP}" \
	"${PYRRHAD_DATADIR}"

	checkpath \
	-d \
	--mode 0755 \
	--owner "${PYRRHAD_USER}:${PYRRHAD_GROUP}" \
	"${PYRRHAD_PIDDIR}"

	checkpath -f \
	-o ${PYRRHAD_USER}:${PYRRHAD_GROUP} \
	-m 0660 \
	${PYRRHAD_CONFIGFILE}

	checkconfig || return 1
}

checkconfig()
{
	if ! grep -qs '^rpcpassword=' "${PYRRHAD_CONFIGFILE}" ; then
		eerror ""
		eerror "ERROR: You must set a secure rpcpassword to run pyrrhad."
		eerror "The setting must appear in ${PYRRHAD_CONFIGFILE}"
		eerror ""
		eerror "This password is security critical to securing wallets "
		eerror "and must not be the same as the rpcuser setting."
		eerror "You can generate a suitable random password using the following"
		eerror "command from the shell:"
		eerror ""
		eerror "bash -c 'tr -dc a-zA-Z0-9 < /dev/urandom | head -c32 && echo'"
		eerror ""
		eerror "It is also recommended that you also set alertnotify so you are "
		eerror "notified of problems:"
		eerror ""
		eerror "ie: alertnotify=echo %%s | mail -s \"Pyrrha Alert\"" \
			"admin@foo.com"
		eerror ""
		return 1
	fi
}
