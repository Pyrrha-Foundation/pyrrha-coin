[Unit]
Description=Pyrrha Miner
After=pyrrha.service
Requires=pyrrha.service

[Service]
User=pyrrha
Group=pyrrha

Type=simple
PIDFile=/home/pyrrha/.pyrrha/pyrrha-miner.pid
ExecStart=/home/pyrrha/pyrrha/bin/pyrrha-miner -conf=/home/pyrrha/.pyrrha/pyrrha.conf -cpus=8

Restart=always
PrivateTmp=true
TimeoutStopSec=60s
TimeoutStartSec=2s
StartLimitInterval=120s
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
