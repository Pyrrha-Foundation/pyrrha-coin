bin_PROGRAMS += bench/bench_pyrrha
BENCH_SRCDIR = bench
BENCH_BINARY = bench/bench_pyrrha$(EXEEXT)

RAW_BENCH_FILES = \
  bench/data/block413567.raw
GENERATED_BENCH_FILES = $(RAW_BENCH_FILES:.raw=.raw.h)

bench_bench_pyrrha_SOURCES = \
  test/test_pyrrha.h \
  test/test_pyrrha.cpp \
  test/testutil.h \
  test/testutil.cpp \
  $(RAW_BENCH_FILES) \
  bench/adaptive_blocksize.cpp \
  bench/bench_constants.h \
  bench/bench_pyrrha.cpp \
  bench/bench.cpp \
  bench/bench.h \
  bench/block_assemble.cpp \
  bench/checkblock.cpp \
  bench/checkqueue.cpp \
  bench/Examples.cpp \
  bench/data.h \
  bench/data.cpp \
  bench/crypto_hash.cpp \
  bench/merkle_root.cpp \
  bench/murmur_hash.cpp \
  bench/rpc_mempool.cpp \
  bench/rpc_blockchain.cpp \
  bench/rollingbloom.cpp \
  bench/bloom.cpp \
  bench/prevector.cpp \
  bench/ccoins_caching.cpp \
  bench/mempool_eviction.cpp \
  bench/verify_script.cpp \
  bench/base58.cpp

nodist_bench_bench_pyrrha_SOURCES = $(GENERATED_BENCH_FILES)

bench_bench_pyrrha_CPPFLAGS = $(AM_CPPFLAGS) $(PYRRHA_INCLUDES) $(EVENT_CLFAGS) $(EVENT_PTHREADS_CFLAGS) -I$(builddir)/bench/
bench_bench_pyrrha_CXXFLAGS = $(AM_CXXFLAGS) $(PIE_FLAGS)
bench_bench_pyrrha_LDADD = \
  $(LIBPYRRHA_SERVER) \
  $(LIBPYRRHA_CLI) \
  $(LIBPYRRHA_WALLET) \
  $(LIBPYRRHA_COMMON) \
  $(LIBPYRRHA_UTIL) \
  $(LIBPYRRHA_CONSENSUS) \
  $(LIBPYRRHA_CRYPTO) \
  $(LIBPYRRHA_CRYPTO_SSE41) \
  $(LIBPYRRHA_CRYPTO_AVX2) \
  $(LIBUNIVALUE) \
  $(LIBLEVELDB) \
  $(LIBLEVELDB_SSE42) \
  $(LIBMEMENV) \
  $(LIBSECP256K1) \
  $(BOOST_LIBS) \
  $(BOOST_UNIT_TEST_FRAMEWORK_LIB) \
  $(LIBRSM)

if ENABLE_ZMQ
bench_bench_pyrrha_LDADD += $(LIBPYRRHA_ZMQ) $(ZMQ_LIBS)
endif

if ENABLE_WALLET
bench_bench_pyrrha_SOURCES += bench/coin_selection.cpp
endif

bench_bench_pyrrha_LDADD += \
  $(BDB_LIBS) \
  $(SSL_LIBS) \
  $(CRYPTO_LIBS) \
  $(MINIUPNPC_LIBS) \
  $(EVENT_PTHREADS_LIBS) \
  $(EVENT_LIBS)

bench_bench_pyrrha_LDFLAGS = $(RELDFLAGS) $(AM_LDFLAGS) $(LIBTOOL_APP_LDFLAGS) $(PTHREAD_FLAGS)

CLEAN_PYRRHA_BENCH = bench/*.gcda bench/*.gcno $(GENERATED_BENCH_FILES)

CLEANFILES += $(CLEAN_PYRRHA_BENCH)

bench/data.cpp: bench/data/block413567.raw.h

pyrrha_bench: $(BENCH_BINARY)

bench: $(BENCH_BINARY) FORCE
	$(BENCH_BINARY)

pyrrha_bench_clean : FORCE
	rm -f $(CLEAN_PYRRHA_BENCH) $(bench_bench_pyrrha_OBJECTS) $(BENCH_BINARY)

%.raw.h: %.raw
	@$(MKDIR_P) $(@D)
	@{ \
	 echo "static unsigned const char $(*F)_raw[] = {" && \
	 $(HEXDUMP) -v -e '8/1 "0x%02x, "' -e '"\n"' $< | $(SED) -e 's/0x  ,//g' && \
	 echo "};"; \
	} > "$@.new" && mv -f "$@.new" "$@"
	@echo "Generated $@"
