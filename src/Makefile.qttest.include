bin_PROGRAMS += qt/test/test_pyrrha-qt
TESTS += qt/test/test_pyrrha-qt

TEST_QT_MOC_CPP = \
  qt/test/moc_pyrrhaaddressvalidatortests.cpp \
  qt/test/moc_uritests.cpp

if ENABLE_WALLET
TEST_QT_MOC_CPP += qt/test/moc_paymentservertests.cpp \
  qt/test/moc_guiutiltests.cpp
endif

TEST_QT_H = \
  qt/test/pyrrhaaddressvalidatortests.h \
  qt/test/guiutiltests.h \
  qt/test/uritests.h \
  qt/test/paymentrequestdata.h \
  qt/test/paymentservertests.h

qt_test_test_pyrrha_qt_CPPFLAGS = $(AM_CPPFLAGS) $(PYRRHA_INCLUDES) $(PYRRHA_QT_INCLUDES) \
  $(QT_INCLUDES) $(QT_TEST_INCLUDES) $(PROTOBUF_CFLAGS)

qt_test_test_pyrrha_qt_SOURCES = \
  qt/test/pyrrhaaddressvalidatortests.cpp \
  qt/test/test_main.cpp \
  qt/test/uritests.cpp \
  $(TEST_QT_H)
if ENABLE_WALLET
qt_test_test_pyrrha_qt_SOURCES += \
  qt/test/guiutiltests.cpp \
  qt/test/paymentservertests.cpp
endif

nodist_qt_test_test_pyrrha_qt_SOURCES = $(TEST_QT_MOC_CPP)

qt_test_test_pyrrha_qt_LDADD = $(LIBPYRRHAQT) $(LIBPYRRHA_SERVER) $(EVENT_LIBS)
if ENABLE_WALLET
qt_test_test_pyrrha_qt_LDADD += $(LIBPYRRHA_WALLET)
endif
if ENABLE_ZMQ
qt_test_test_pyrrha_qt_LDADD += $(LIBPYRRHA_ZMQ) $(ZMQ_LIBS)
endif
qt_test_test_pyrrha_qt_LDADD += $(LIBPYRRHA_CLI) $(LIBPYRRHA_COMMON) $(LIBPYRRHA_UTIL) $(LIBPYRRHA_CONSENSUS) $(LIBPYRRHA_CRYPTO) $(LIBPYRRHA_CRYPTO_SSE41) $(LIBPYRRHA_CRYPTO_AVX2) $(LIBUNIVALUE) $(LIBLEVELDB) \
  $(LIBLEVELDB_SSE42) $(LIBMEMENV) $(BOOST_LIBS) $(QT_DBUS_LIBS) $(QT_TEST_LIBS) $(QT_LIBS) \
  $(QR_LIBS) $(PROTOBUF_LIBS) $(BDB_LIBS) $(SSL_LIBS) $(CRYPTO_LIBS) $(MINIUPNPC_LIBS) $(LIBSECP256K1) $(LIBRSM)\
  $(EVENT_PTHREADS_LIBS) $(EVENT_LIBS)
qt_test_test_pyrrha_qt_LDFLAGS = $(RELDFLAGS) $(AM_LDFLAGS) $(QT_LDFLAGS) $(LIBTOOL_APP_LDFLAGS) $(PTHREAD_FLAGS)
qt_test_test_pyrrha_qt_CXXFLAGS = $(AM_CXXFLAGS) $(QT_PIE_FLAGS)

CLEAN_PYRRHA_QT_TEST = $(TEST_QT_MOC_CPP) qt/test/*.gcda qt/test/*.gcno

CLEANFILES += $(CLEAN_PYRRHA_QT_TEST)

test_pyrrha_qt : qt/test/test_pyrrha-qt$(EXEEXT)

test_pyrrha_qt_check : qt/test/test_pyrrha-qt$(EXEEXT) FORCE
	$(MAKE) check-TESTS TESTS=$^

test_pyrrha_qt_clean: FORCE
	rm -f $(CLEAN_PYRRHA_QT_TEST) $(qt_test_test_pyrrha_qt_OBJECTS)
